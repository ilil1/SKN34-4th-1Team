# LLM 지원사업 후보 점수화
# 실제 키는 로컬 .env에만 입력하고 커밋하지 마세요.
OPENAI_API_KEY=
# 선택: 관리자 AI 비용 화면의 조직 사용량·실제 비용(OpenAI Usage·Costs API). 조직 관리자 키(Admin key)만 되고, 비우면 앱 기록만 봅니다.
# 프로젝트 ID를 적으면 두 API 모두 그 프로젝트로 제한하고, 환율을 적으면 원화를 함께 보입니다.
OPENAI_ADMIN_KEY=
OPENAI_PROJECT_ID=
AI_COST_KRW_PER_USD=

# Core→AI 검색·근거 답변 추적. 기본 비활성화; 두 서비스에 같은 프로젝트 설정을 적용합니다.
# 컨테이너에서 개발 서버 연결은 infrastructure/llmops/README.md 참고.
LANGFUSE_ENABLED=false
LANGFUSE_BASE_URL=http://localhost:13000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_ENVIRONMENT=development
# 실제 빌드 커밋이 확정된 환경에서 설정
GIT_SHA=
# 루트 Compose는 Catalog 분리형입니다. 32자 이상의 무작위 서버 전용 비밀값을 설정하세요.
# Core와 Catalog에만 전달하며 프론트·Git에는 실제 값을 넣지 않습니다.
CATALOG_INTERNAL_TOKEN=
# 조건 해석·RAG 답변은 GPT-6 Luna를 사용합니다. 공식 API ID는 gpt-6-luna입니다.
OPENAI_MODEL=gpt-6-luna
# 랭킹도 비용 절감을 위해 Luna를 사용합니다. 기존 추론 low와 Fast 옵션은 유지합니다.
# 모델을 비워 두면 OPENAI_MODEL을 상속합니다. 추론 수준은 none 또는 low만 지원합니다.
OPENAI_RANKING_MODEL=gpt-6-luna
OPENAI_RANKING_REASONING_EFFORT=low
# 도우미 자유 질문(의도 분류)은 가장 싼 모델을 씁니다. 비우면 gpt-5-nano/low이며 다른 기능의 모델은 바꾸지 않습니다.
# 기존 의도 분류 평가의 nano/low 설정을 유지합니다. 과거 Luna 비교는 GPT-6 Luna 측정값이 아닙니다.
OPENAI_ASSISTANT_MODEL=gpt-5-nano
OPENAI_ASSISTANT_REASONING_EFFORT=low
# 도우미 도구 에이전트(모집글 매칭·내 상태·관심 공고)의 계획·답 모델. 비우면 gpt-6-luna입니다.
OPENAI_ASSISTANT_AGENT_MODEL=gpt-6-luna
# Fast 상시 사용 프로필: 일반 처리보다 추가 요금이 있습니다. 일반 처리는 default로 변경합니다.
OPENAI_RANKING_SERVICE_TIER=priority
LLM_MODEL_TIMEOUT_SECONDS=25.0
LLM_RUN_TIMEOUT_SECONDS=30.0
# 긴 공식 원문 구조화 분석 전용 시간 예산입니다.
LLM_COMBINATION_REVIEW_MODEL_TIMEOUT_SECONDS=60.0
LLM_COMBINATION_REVIEW_RUN_TIMEOUT_SECONDS=70.0
# 원문 자격을 검토하는 후보 점수화에만 별도 시간 예산을 사용합니다.
LLM_RANKING_MODEL_TIMEOUT_SECONDS=45.0
LLM_RANKING_RUN_TIMEOUT_SECONDS=50.0
# Core API 제한시간은 agent run 제한시간보다 응답 처리 여유만큼 길게 유지합니다.
AI_SERVICE_READ_TIMEOUT=35s
AI_COMBINATION_REVIEW_READ_TIMEOUT=75s
AI_RANKING_READ_TIMEOUT=55s

# 검색·근거 답변 합산, 한 Core 프로세스 기준. IP는 신원이 아니며 프록시/NAT 뒤에서는 한도를 공유합니다.
SUPPORT_PROGRAM_REQUEST_PER_CLIENT_PER_MINUTE=6
SUPPORT_PROGRAM_REQUEST_GLOBAL_PER_MINUTE=60
SUPPORT_PROGRAM_REQUEST_MAX_CONCURRENT=4

# 전체 공고 의미 검색. 공고/질의 임베딩 생성 시 OpenAI 사용 비용이 발생합니다.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_EMBEDDING_REQUEST_TOKEN_LIMIT=262112
EMBEDDING_TIMEOUT_SECONDS=15
QDRANT_TIMEOUT_SECONDS=5
QDRANT_HOST_PORT=6333

# Nori + BM25 키워드 후보 검색. Compose는 내부 elasticsearch 주소를 사용한다.
ELASTICSEARCH_INDEX_NAME=govbiz-support-program-lexical-v2
ELASTICSEARCH_CONNECT_TIMEOUT=2s
ELASTICSEARCH_READ_TIMEOUT=10s
# Core를 호스트에서 실행할 때만 접근 가능한 별도 ES 주소를 지정한다. Compose는 9200을 공개하지 않는다.
# ELASTICSEARCH_BASE_URL=http://127.0.0.1:9200
# ELASTICSEARCH_API_KEY=
AI_SEMANTIC_SEARCH_READ_TIMEOUT=30s
# MySQL의 현재 공고와 Qdrant를 비교하고 누락·변경된 벡터를 재처리합니다.
SUPPORT_PROGRAM_INDEX_ENABLED=true
SUPPORT_PROGRAM_INDEX_INITIAL_DELAY=PT0S
SUPPORT_PROGRAM_INDEX_FIXED_DELAY=PT1M
# AI Service를 Compose 밖에서 실행할 때만 지정합니다.
# QDRANT_URL=http://127.0.0.1:6333
# QDRANT_API_KEY=

# Core API 지원사업 카탈로그용 로컬 MySQL. Compose는 DB를 loopback 주소로만 공개합니다.
# 운영·공유 환경에서는 두 비밀번호를 별도 secret으로 바꾸세요.
MYSQL_DATABASE=govbiz
MYSQL_USER=govbiz
MYSQL_PASSWORD=govbiz-local
MYSQL_ROOT_PASSWORD=govbiz-root-local
MYSQL_HOST_PORT=3306

# Compose의 Redis는 내부망 redis:6379만 사용한다(호스트 포트 없음).
# Core를 직접 실행하면 별도 Redis를 준비하고 REDIS_HOST/REDIS_PORT를 지정한다.
# 운영 Redis 인증/TLS는 REDIS_USERNAME/REDIS_PASSWORD/REDIS_SSL_ENABLED로 주입한다.
REDIS_CONNECT_TIMEOUT=1s
REDIS_TIMEOUT=1s
# 리포트·중복 검토·공식 문서 분석 작업 전달용 RabbitMQ. 운영에서는 별도 자격증명을 사용한다.
RABBITMQ_USERNAME=govbiz
RABBITMQ_PASSWORD=govbiz-rabbit-local
DAILY_REPORT_QUEUE_ENABLED=true
DAILY_REPORT_DELIVERY_QUEUE_ENABLED=true
# 카카오 탈퇴 연결 해제. false이면 작업은 DB에 남고 재가입 제한도 유지됩니다.
ACCOUNT_OAUTH_UNLINK_ENABLED=true
# 큐가 없으면 false: 같은 DB 작업을 전용 스케줄러가 직접 처리합니다.
ACCOUNT_OAUTH_UNLINK_QUEUE_ENABLED=true
COMBINATION_REVIEW_QUEUE_ENABLED=true
# 중복 검토 새 실행의 AI 계약: v3 세 질문(기본) | v2 여섯 단계(되돌릴 때만)
COMBINATION_REVIEW_CONTRACT_VERSION=v3
APPLICATION_FORM_DISCOVERY_QUEUE_ENABLED=true
# 격리 스모크 검증은 다른 포트를 사용하므로 개발 서비스와 함께 실행할 수 있습니다.
CORE_API_HOST_PORT=8080
WEB_HOST_PORT=5173
# Compose의 Vite가 바인드 마운트 소스를 폴링하는 간격(ms). 짧을수록 web 컨테이너 CPU가 오르고 /api 프록시가 느려진다.
CHOKIDAR_INTERVAL=1000
# 도우미 "담당자에게 문의" 버튼이 여는 카카오톡 채널 공개 ID(`_`로 시작). 비우면 버튼을 보여 주지 않습니다.
KAKAO_CHANNEL_ID=
# 도우미 자유 질문의 AI 호출 스위치(Web의 VITE_ASSISTANT_AI_ENABLED로 전달). true일 때만 OPENAI_ASSISTANT_MODEL을 호출합니다.
ASSISTANT_AI_ENABLED=false
# 도우미 도구 에이전트(LangGraph). Core와 AI Service가 공유하는 비밀(32자 이상)이 있어야 내부 도구 API가 열리고,
# ASSISTANT_AGENT_ENABLED=true면 자료가 필요한 질문(모집글 매칭·내 상태·관심 공고)을 에이전트 경로로 보냅니다.
ASSISTANT_AGENT_ENABLED=false
ASSISTANT_TOOLS_TOKEN=
# 관심 공고를 담을 때 공고 원문을 미리 수집·색인하는 큐(RabbitMQ). 꺼져 있으면 관심 공고 질문 때 원문을 수집합니다(느림).
ASSISTANT_PREFETCH_QUEUE_ENABLED=true

# 백그라운드 기업마당 공고 동기화에만 사용하는 공공데이터포털 개인 서비스키
# 사용자 검색은 MySQL 카탈로그를 읽으며 외부 API를 직접 호출하지 않습니다.
# Encoding 또는 Decoding 키를 그대로 입력하면 Core API가 동기화 외부 호출 전에 정규화합니다.
DATA_GO_KR_SERVICE_KEY=

# 공공데이터포털 K-Startup 조회서비스 활용 승인이 별도로 필요합니다.
# 인증키가 같아도 제공처 설정은 분리합니다. Encoding/Decoding 키 모두 지원합니다.
KSTARTUP_API_KEY=
# RECENT_YEAR: API 날짜 조건에 서울 기준 1년 전, RECENT_THREE_MONTHS: 3개월 전 날짜를 전달합니다.
# 실응답에는 그보다 먼저 시작한 장기 공고도 포함될 수 있습니다. OPEN: API의 모집 중 공고만.
# 최초 수집·벡터 색인에는 OpenAI 임베딩 비용이 발생하므로 확인 후 true로 켜세요.
KSTARTUP_SYNC_SCOPE=RECENT_YEAR
KSTARTUP_SYNC_ENABLED=false
KSTARTUP_SYNC_INITIAL_DELAY=PT0S
KSTARTUP_SYNC_FIXED_DELAY=PT6H
# KSTARTUP_API_BASE_URL=https://apis.data.go.kr
# KSTARTUP_API_CONNECT_TIMEOUT=2s
# KSTARTUP_API_READ_TIMEOUT=10s

# 과기정통부 사업공고 / 충청남도 수출입공지: 각각 공공데이터포털 활용 승인이 필요합니다.
# 전용 키를 생략하면 DATA_GO_KR_SERVICE_KEY를 사용합니다. 키가 같아도 승인은 별도입니다.
# MSIT_API_KEY=
# CNTRADE_NOTICE_API_KEY=
# 접수 기간·지역·분야를 제공하지 않는 항목은 추정하지 않습니다. 상태 미확인/전체에서 조회합니다.
# MSIT는 API 전체 페이지를 검증하므로 초기 수집에 오래 걸릴 수 있습니다(실측 10건/페이지).
# 실제 API가 정상인지 확인하고 최초 임베딩 비용을 승인한 뒤 각각 활성화하세요.
MSIT_SYNC_ENABLED=false
MSIT_SYNC_INITIAL_DELAY=PT0S
MSIT_SYNC_FIXED_DELAY=PT6H
CNTRADE_NOTICE_SYNC_ENABLED=false
CNTRADE_NOTICE_SYNC_INITIAL_DELAY=PT0S
CNTRADE_NOTICE_SYNC_FIXED_DELAY=PT6H
# MSIT_API_BASE_URL=https://apis.data.go.kr
# MSIT_API_CONNECT_TIMEOUT=2s
# MSIT_API_READ_TIMEOUT=20s
# CNTRADE_NOTICE_API_BASE_URL=https://apis.data.go.kr
# CNTRADE_NOTICE_API_CONNECT_TIMEOUT=2s
# CNTRADE_NOTICE_API_READ_TIMEOUT=20s

# "로그인 상태 유지"를 켠 세션의 절대 만료 기간(ISO-8601). 기본 30일
ACCOUNT_SESSION_TTL=P30D
# "로그인 상태 유지"를 끈 세션의 절대 만료 기간. 기본 12시간
ACCOUNT_SESSION_SHORT_TTL=PT12H
# 마지막 사용 뒤 세션을 끝내는 유휴 기간. 기본 7일
ACCOUNT_SESSION_IDLE_TTL=P7D
# 세션 JWT의 HS256 서명 비밀키(32자 이상). Core API 코드에는 기본값이 없어 비어 있으면 기동하지 않습니다. 운영 환경에서는 반드시 바꿉니다.
ACCOUNT_JWT_SECRET=govbiz-local-jwt-secret-change-in-production
# 세션 쿠키의 Secure 속성. 로컬 http 개발에서는 false, HTTPS 운영에서는 true
ACCOUNT_COOKIE_SECURE=false
# 로컬 Compose 첫 기동 때 공용 데모 데이터와 대상 계정별 신청 준비 2건·중복 검토 2건을 넣습니다.
# 대상 이메일이 비어 있으면 admin@govbiz.local과 member@govbiz.local을 자동 선택하고, 쉼표로 지정하면 해당 활성 계정만 보충합니다.
# 일반 사용자 작업은 건드리지 않습니다. 공용 데모까지 다시 넣으려면 DEMO_SEED_FORCE=true로 demo-seed를 실행합니다.
# 기업마당 공고 동기화가 끝나야 모집글을 붙일 수 있어 최대 DEMO_SEED_WAIT_SECONDS 동안 기다립니다.
DEMO_SEED_ENABLED=true
DEMO_SEED_FORCE=false
DEMO_SEED_TARGET_EMAILS=
DEMO_SEED_WAIT_SECONDS=600

# 개발용 자동 로그인. true면 POST /api/v1/auth/dev-login이 관리자 또는 회원 시드 계정(없으면 생성)의 세션을 발급합니다.
# 운영 환경에서는 반드시 false로 둡니다.
ACCOUNT_DEV_LOGIN_ENABLED=true
ACCOUNT_DEV_LOGIN_EMAIL=admin@govbiz.local
ACCOUNT_DEV_LOGIN_MEMBER_EMAIL=member@govbiz.local
ACCOUNT_DEV_LOGIN_PASSWORD=govbiz-admin1

# 개발용 요금제 무제한 계정(쉼표 구분). 사용량은 세지만 한도로 막지 않습니다. 운영 환경에서는 반드시 비웁니다.
# 이 줄을 지우면 로컬 Compose 기본값(데모 시드 계정 6개)을 쓰고, 빈 값으로 두면 모든 계정에 한도를 적용합니다.
PLAN_USAGE_UNLIMITED_ACCOUNT_EMAILS=admin@govbiz.local,member@govbiz.local,jihoon.park@demo.govbiz.local,hana.choi@demo.govbiz.local,dohyun.jung@demo.govbiz.local,yuna.kang@demo.govbiz.local

# 비밀번호 재설정 메일. SMTP_*를 함께 설정해야 하며, 꺼져 있으면 개발용 로그인이 켜진 환경에서 링크를 core-service 로그로 남긴다.
ACCOUNT_PASSWORD_RESET_MAIL_ENABLED=false
ACCOUNT_PASSWORD_RESET_FROM=
# 회원가입 인증번호 메일은 위 재설정 메일의 발송 여부·발신 주소를 그대로 쓴다. 인증번호 유효 시간만 따로 정한다(기본 10분).
ACCOUNT_EMAIL_VERIFICATION_CODE_TTL=PT10M

# 소셜 로그인(카카오·Google, OAuth 2.0 + OpenID Connect). 공급자별로 클라이언트 ID와 시크릿이 둘 다 있어야 그 버튼이
# 보이고, 비어 있으면 그 공급자만 꺼집니다. 실제 키는 로컬 .env에만 넣고 커밋하지 마세요.
# 공급자 콘솔에 등록할 Redirect URI는 <ACCOUNT_OAUTH_CALLBACK_BASE_URL>/api/v1/auth/oauth/{kakao|google}/callback 입니다.
# 로컬 Compose는 브라우저가 5173만 쓰고 Vite가 /api를 Core로 넘기므로 APP_CORS_ALLOWED_ORIGIN과 같은 origin을 씁니다.
#   예) http://127.0.0.1:5173/api/v1/auth/oauth/kakao/callback
#       http://127.0.0.1:5173/api/v1/auth/oauth/google/callback
ACCOUNT_OAUTH_CALLBACK_BASE_URL=http://127.0.0.1:5173
# 소셜 로그인을 마친 뒤 돌아갈 프런트 origin
ACCOUNT_OAUTH_FRONTEND_BASE_URL=http://127.0.0.1:5173
# 모바일 소셜 로그인을 켤 때만 지정합니다. 허용한 앱 복귀 URI와 정확히 일치해야 합니다.
ACCOUNT_MOBILE_OAUTH_REDIRECT_URIS=
# Google Cloud Console > Google Auth Platform > Clients(웹 애플리케이션)의 클라이언트 ID와 보안 비밀번호
ACCOUNT_OAUTH_GOOGLE_CLIENT_ID=
ACCOUNT_OAUTH_GOOGLE_CLIENT_SECRET=
# Kakao Developers > 앱 키의 REST API 키와 카카오 로그인 > 보안의 Client Secret.
# 카카오 로그인 > 일반에서 OpenID Connect를 켜고, 동의항목에 카카오계정(이메일)을 설정해야 합니다.
ACCOUNT_OAUTH_KAKAO_CLIENT_ID=
ACCOUNT_OAUTH_KAKAO_CLIENT_SECRET=
# 회원 탈퇴 연결 해제용 어드민 키. 없으면 탈퇴 작업은 FAILED로 남고 같은 카카오 계정의 재가입을 차단합니다.
ACCOUNT_OAUTH_KAKAO_ADMIN_KEY=
# ACCOUNT_OAUTH_CONNECT_TIMEOUT=2s
# ACCOUNT_OAUTH_READ_TIMEOUT=10s

# 기업 등록 시 사업자등록번호로 국세청 등록 여부·상호·사업자 상태를 확인하는 Bizno(bizno.net) API 키.
# 비어 있으면 기업 조회·등록 요청은 503 BIZNO_NOT_CONFIGURED를 반환하고 다른 기능에는 영향이 없습니다.
BIZNO_API_KEY=
BIZNO_URL=https://bizno.net/api/fapi

# Core API가 허용할 브라우저 origin(쉼표로 여러 개). CORS와 세션 쿠키 요청의 Origin 검사에 함께 쓰입니다.
APP_CORS_ALLOWED_ORIGIN=http://127.0.0.1:5173

# 일반 실행에서는 아래 동기화용 기본값을 그대로 사용합니다. 로컬 스텁이나 timeout 조정이 필요할 때만
# 주석을 해제하세요.
# BIZINFO_API_BASE_URL=https://apis.data.go.kr
# BIZINFO_API_CONNECT_TIMEOUT=2s
# BIZINFO_API_READ_TIMEOUT=10s

# 기업마당 공고 카탈로그 동기화. 사용자 검색은 이 MySQL 카탈로그를 읽습니다.
# PT0S는 앱 준비 뒤 즉시 한 번 실행하고, PT6H는 이전 동기화가 끝난 시점부터 6시간 뒤에 다시 실행한다는 뜻입니다.
BIZINFO_SYNC_ENABLED=true
BIZINFO_SYNC_INITIAL_DELAY=PT0S
BIZINFO_SYNC_FIXED_DELAY=PT6H

# 기업 맞춤 리포트. SMTP 설정·수신 주소 확인·명시적 동의를 마친 뒤에만 켭니다.
# 두 스위치가 false여도 로그인한 기업 회원의 수동 미리보기는 AI를 호출할 수 있습니다.
DAILY_REPORT_ENABLED=false
DAILY_REPORT_MAIL_ENABLED=false
DAILY_REPORT_FRONTEND_BASE_URL=http://127.0.0.1:5173
DAILY_REPORT_FROM=
DAILY_REPORT_SEND_HOUR=8
# Independent of SMTP; off until Android/iOS push credentials are configured.
DAILY_REPORT_PUSH_ENABLED=false
# Optional Expo enhanced push security token; never place in EXPO_PUBLIC_*.
DAILY_REPORT_PUSH_ACCESS_TOKEN=
DAILY_REPORT_MAX_ACCOUNTS_PER_RUN=20
DAILY_REPORT_MAX_REPORTS_PER_DAY=20
DAILY_REPORT_MAX_PROGRAMS=3
# 관심 공고 마감 알림. 켜면 조건을 충족한 계정에 위 리포트 메일·앱 알림 설정으로 실제 발송합니다.
DEADLINE_REMINDER_ENABLED=false
DEADLINE_REMINDER_SEND_HOUR=9
DEADLINE_REMINDER_MAX_PER_RUN=50
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS_ENABLED=true
SMTP_SSL_ENABLED=false

# Application-form discovery only; interpretation/draft/document timeouts stay unchanged.
APPLICATION_FORM_DISCOVERY_MODEL_TIMEOUT_SECONDS=210
APPLICATION_FORM_DISCOVERY_RUN_TIMEOUT_SECONDS=240
APPLICATION_FORM_DISCOVERY_READ_TIMEOUT=270s
APPLICATION_FORM_WORKER_LEASE=1800s
APPLICATION_FORM_ANALYSIS_ENABLED=false

# Document MCP pipeline. Generate private tokens outside this file; no public endpoint.
DOCUMENT_INTERNAL_TOKEN=
# Local development: absolute executables in isolated environments, args as JSON arrays.
DOCUMENT_HWPX_COMMAND=
DOCUMENT_HWPX_ARGS=[]
DOCUMENT_PDF_COMMAND=
DOCUMENT_PDF_ARGS=[]
DOCUMENT_KORDOC_COMMAND=
DOCUMENT_KORDOC_ARGS=[]
